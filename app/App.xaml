<Application x:Class="QxBgmManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
             xmlns:conv="clr-namespace:QxBgmManager.Converters"
             xmlns:services="clr-namespace:QxBgmManager.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <vio:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 字体（对齐 BetterGI）===== -->
            <FontFamily x:Key="TextThemeFontFamily">/Resources/Fonts/MiSans-Regular.ttf#MiSans</FontFamily>

            <!-- ===== 设计令牌（对齐 BetterGI）===== -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <Thickness x:Key="PagePadding">48,20,48,28</Thickness>

            <!-- ===== 全局 Converter ===== -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:StatusDotConverter x:Key="StatusDot" />
            <conv:BoolToTextConverter x:Key="BoolToText" />
            <conv:EnumMatchToVisibilityConverter x:Key="EnumStatusToVis" />
            <conv:EnumMatchToVisibilityConverter x:Key="EnumFixToVis" />
            <conv:EnvCheckLevelConverter x:Key="EnumLevelToText" />
            <conv:BoolToWarnBrushConverter x:Key="BoolToWarnBrush" />

            <!-- ===== 选中态覆盖（问题3：App 刷了纯色 accent，WPF-UI 选中态直接用实底导致看不清）。
                 放在 ControlsDictionary 之后，以低透明度 accent 底 + 主题自适应文字替换实底；
                 悬停态模板用 SubtleFill（弱），天然比选中态更弱。主按钮 Accent 不受影响。 ===== -->
            <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#2E6EE7B7" />
            <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E6EE7B7" />
            <Color x:Key="{x:Static SystemColors.HighlightColorKey}">#2E6EE7B7</Color>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#226EE7B7" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextFillColorPrimary}" />

            <Style TargetType="Page">
                <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
                <!-- 禁用导航框架的外层滚动，让页面取得有限高度并自行滚动。 -->
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                <Setter Property="services:ScrollBehavior.IsEnabled" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
