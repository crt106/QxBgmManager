<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>QxBgmManager</AssemblyName>
    <RootNamespace>QxBgmManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.1</Version>
    <Description>千星BGM替换管理器 - 千星奇域曲库试听与 BGM 原位替换补丁管理</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="WPF-UI.Violeta" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\MiSans-Regular.ttf" />
  </ItemGroup>

  <!-- 自测控制台项目（Tests\ 下）不纳入主程序编译 -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QxBgmManager.SchemeTests" />
    <InternalsVisibleTo Include="QxBgmManager.UiTests" />
  </ItemGroup>

</Project>
