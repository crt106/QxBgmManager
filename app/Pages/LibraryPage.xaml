<Page x:Class="QxBgmManager.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      Title="曲库"
      d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="曲库" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />

        <!-- 左侧分类栏 -->
        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{Binding Name}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border Grid.Column="1" VerticalAlignment="Center"
                                MinWidth="34" Height="20" CornerRadius="10" Padding="8,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding Count}" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 主区 -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="搜索曲名 / fileID / 索引 / 专辑"
                            Icon="{ui:SymbolIcon Search24}" />
                <ComboBox Grid.Column="1" Width="96" Margin="8,0,0,0"
                          SelectedIndex="{Binding PatchFilterIndex}">
                    <ComboBoxItem Content="全部状态" />
                    <ComboBoxItem Content="已补丁" />
                    <ComboBoxItem Content="未补丁" />
                </ComboBox>
                <ComboBox Grid.Column="2" Width="120" Margin="8,0,0,0"
                          ItemsSource="{Binding PckFilters}"
                          SelectedItem="{Binding PckFilter}" />
                <ComboBox Grid.Column="3" Width="96" Margin="8,0,0,0"
                          SelectedIndex="{Binding SortIndex}">
                    <ComboBoxItem Content="按索引" />
                    <ComboBoxItem Content="按时长" />
                    <ComboBoxItem Content="按大小" />
                    <ComboBoxItem Content="按 fileID" />
                </ComboBox>
                <TextBlock Grid.Column="5" VerticalAlignment="Center"
                           Text="{Binding StatsText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- 表格 + 空结果占位 -->
            <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding Rows}"
                          MouseDoubleClick="DataGrid_MouseDoubleClick"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                          Background="Transparent" BorderThickness="0"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          RowHeight="42"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="曲名" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 单行 TextBlock + Run 组合（省一层 StackPanel，软渲染下每行少一次布局） -->
                                    <TextBlock ToolTipService.ToolTip="{Binding TooltipText}" Margin="2,1"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{Binding TrackName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="{Binding EnglishName, Mode=OneWay}" FontSize="11"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="索引" Binding="{Binding IndexText}" Width="0.6*" />
                        <DataGridTextColumn Header="fileID" Binding="{Binding FileId}" Width="1*" />
                        <DataGridTemplateColumn Header="分类" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,1" HorizontalAlignment="Left"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding CategoryText}" FontSize="12"
                                                   Foreground="{Binding CategoryColor}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="0.7*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="0.8*" />
                        <DataGridTemplateColumn Header="补丁" Width="0.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="已补丁" Foreground="#6EE7B7" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPatched, Converter={StaticResource BoolToVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="0.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="{Binding Playing, Converter={StaticResource BoolToText}, ConverterParameter='停止|试听'}"
                                               Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                                               Padding="12,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="无匹配条目" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button Grid.Column="1" Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Command="{Binding RefreshCommand}"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
        </Grid>
    </Grid>
</Page>
