<Page x:Class="QxBgmManager.Pages.ReplaceCenterPage" Style="{StaticResource {x:Type Page}}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      xmlns:controls="clr-namespace:QxBgmManager.Controls"
      Title="替换中心"
      d:DataContext="{d:DesignInstance Type=vm:ReplaceCenterViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" Text="替换中心" />

            <!-- 更新警告条：有活动补丁时必须醒目 -->
            <ui:InfoBar Margin="0,0,0,12"
                        Title="已替换音乐"
                        Message="更新或修复游戏前，请先恢复原曲。"
                        Severity="Warning" IsClosable="False" IsOpen="{Binding HasPatches}" />

            <!-- YuanShen.exe 运行状态 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Bot24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="游戏状态" />
                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Margin="0,0,36,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding GameRunning, Converter={StaticResource StatusDot}}" />
                            <ui:TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontTypography="Body"
                                          Text="{Binding GameRunning, Converter={StaticResource BoolToText}, ConverterParameter='运行中|未运行'}" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- 替换任务（单条 = 加一行；批量 = 多行） -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Icon="{ui:SymbolIcon ArrowSwap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="替换任务" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="添加音频，选择要替换的原曲。" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,8,16,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="添加文件" Command="{Binding AddFilesCommand}"
                                       IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBool}}" />
                            <ui:Button Content="清空列表" Margin="8,0,0,0" Appearance="Secondary"
                                       Command="{Binding ClearJobsCommand}"
                                       IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBool}}" />
                            <ui:TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                          Text="可直接拖放音频文件到列表" />
                        </StackPanel>
                    </Grid>
                    <ListBox Margin="16" MinHeight="140" MaxHeight="420" AllowDrop="True"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Jobs}"
                             Drop="JobsList_Drop"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.ColumnSpan="4" Text="{Binding FileName}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding SourceSummary}" Margin="0,4,0,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <controls:TrackPicker Grid.Row="2" Grid.ColumnSpan="2"
                                                          ItemsSource="{Binding DataContext.Targets, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          SelectedTrack="{Binding Target, Mode=TwoWay}" RequiredBytes="{Binding EstimatedWemBytes}"
                                                          IsEnabled="{Binding DataContext.IsExecuting, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBool}}" />
                                    <ComboBox Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" SelectedIndex="{Binding PresetIndex}"
                                              IsEnabled="{Binding DataContext.IsExecuting, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBool}}"
                                              ItemsSource="{Binding DataContext.PresetNames, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Status}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding TargetSummary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Text="{Binding CapacityAssessment}" TextWrapping="Wrap"
                                               Foreground="{Binding CapacityWarning, Converter={StaticResource BoolToWarnBrush}}" />
                                    <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Text="{Binding Detail}" Margin="0,4,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{Binding TargetConflict, Converter={StaticResource BoolToWarnBrush}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="16,0,16,8">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExecuteProgress}" Height="6" />
                    </Grid>
                    <Grid Margin="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="开始执行" Appearance="Primary"
                                   Command="{Binding ExecuteCommand}"
                                   IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBool}}" />
                        <ui:Button Grid.Column="1" Content="取消" Margin="8,0,0,0"
                                   Command="{Binding CancelExecuteCommand}"
                                   IsEnabled="{Binding IsExecuting}" />
                        <TextBlock Grid.Column="2" Text="{Binding ExecuteStatus}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 活动补丁 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Icon="{ui:SymbolIcon Wrench24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="已替换音乐" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding PatchesStatus}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,8,0"
                                   Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Command="{Binding RefreshPatchesCommand}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,36,0"
                                   Content="全部恢复" Appearance="Danger"
                                   Command="{Binding RestoreAllCommand}"
                                   IsEnabled="{Binding HasPatches}" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <DataGrid ItemsSource="{Binding Patches}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="Transparent" BorderThickness="0" MaxHeight="260"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="音乐包" Binding="{Binding PckName}" Width="130" />
                            <DataGridTextColumn Header="文件编号" Binding="{Binding FileId}" Width="110" />
                            <DataGridTextColumn Header="曲名" Binding="{Binding TrackName}" Width="160" />
                            <DataGridTextColumn Header="原始大小" Binding="{Binding SizeText}" Width="150" />
                            <DataGridTextColumn Header="备份时间" Binding="{Binding TimeText}" Width="160" />
                            <DataGridTemplateColumn Header="操作" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="恢复" Appearance="Secondary" Padding="12,2"
                                                   Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:CardExpander>

            <!-- 日志 -->
            <ui:CardExpander ContentPadding="0" Icon="{ui:SymbolIcon DocumentJs16}">
                <ui:CardExpander.Header>
                    <Grid>
                        <ui:TextBlock FontTypography="Body" Text="日志" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <ListBox ItemsSource="{Binding LogLines}" Height="140" FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
