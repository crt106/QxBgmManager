<Page x:Class="QxBgmManager.Pages.ReplaceCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      Title="替换中心"
      d:DataContext="{d:DesignInstance Type=vm:ReplaceCenterViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" Text="替换中心" />

            <!-- 更新警告条：有活动补丁时必须醒目 -->
            <ui:InfoBar Margin="0,0,0,12"
                        Title="补丁处于活动状态"
                        Message="游戏版本更新/校验文件前必须复原所有补丁，否则可能触发文件校验失败或更新覆盖冲突。"
                        Severity="Warning" IsClosable="False" IsOpen="{Binding HasPatches}" />

            <!-- YuanShen.exe 运行状态 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Bot24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="YuanShen.exe 运行状态" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="游戏运行中可热替换（流式音乐每次播放重读磁盘），但写入/复原可能因文件占用失败。" />
                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Margin="0,0,36,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding GameRunning, Converter={StaticResource StatusDot}}" />
                            <ui:TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontTypography="Body"
                                          Text="{Binding GameRunning, Converter={StaticResource BoolToText}, ConverterParameter='运行中|未运行'}" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- 替换任务（单条 = 加一行；批量 = 多行） -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Icon="{ui:SymbolIcon ArrowSwap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="替换任务" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="添加源音频并为每行选目标条目；逐行 编码 → 容量校验 → 打补丁（队列并发 1）" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,8,16,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="添加文件" Command="{Binding AddFilesCommand}" />
                            <ui:Button Content="清空列表" Margin="8,0,0,0" Appearance="Secondary"
                                       Command="{Binding ClearJobsCommand}" />
                            <ui:TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                          Text="可直接拖放音频文件到列表" />
                        </StackPanel>
                    </Grid>
                    <ListBox Margin="16" MinHeight="120" MaxHeight="260" AllowDrop="True"
                             ItemsSource="{Binding Jobs}"
                             Drop="JobsList_Drop"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding FileName}" Width="200" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <ComboBox Width="330" Margin="8,0,0,0"
                                              ItemsSource="{Binding DataContext.Targets, RelativeSource={RelativeSource AncestorType=Page}}"
                                              SelectedItem="{Binding Target}"
                                              ToolTip="目标条目（索引 曲名 · 容量）">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CapacityText}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Width="110" Margin="8,0,0,0" SelectedIndex="{Binding PresetIndex}"
                                              ItemsSource="{Binding DataContext.PresetNames, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    <TextBlock Text="{Binding Status}" Width="70" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding TargetConflict, Converter={StaticResource BoolToWarnBrush}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="16,0,16,8">
                        <ProgressBar Minimum="0" Maximum="{Binding TotalCount}" Value="{Binding DoneCount}" Height="6" />
                    </Grid>
                    <Grid Margin="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="开始执行" Appearance="Primary"
                                   Command="{Binding ExecuteCommand}"
                                   IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBool}}" />
                        <ui:Button Grid.Column="1" Content="取消" Margin="8,0,0,0"
                                   Command="{Binding CancelExecuteCommand}"
                                   IsEnabled="{Binding IsExecuting}" />
                        <TextBlock Grid.Column="2" Text="{Binding ExecuteStatus}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 活动补丁 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Icon="{ui:SymbolIcon Wrench24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="活动补丁" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding PatchesStatus}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,8,0"
                                   Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Command="{Binding RefreshPatchesCommand}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,36,0"
                                   Content="全部复原" Appearance="Danger"
                                   Command="{Binding RestoreAllCommand}"
                                   IsEnabled="{Binding HasPatches}" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <DataGrid ItemsSource="{Binding Patches}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="Transparent" BorderThickness="0" MaxHeight="260"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pck" Binding="{Binding PckName}" Width="130" />
                            <DataGridTextColumn Header="fileID" Binding="{Binding FileId}" Width="110" />
                            <DataGridTextColumn Header="曲名" Binding="{Binding TrackName}" Width="160" />
                            <DataGridTextColumn Header="原始大小" Binding="{Binding SizeText}" Width="150" />
                            <DataGridTextColumn Header="备份时间" Binding="{Binding TimeText}" Width="160" />
                            <DataGridTemplateColumn Header="操作" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="复原" Appearance="Secondary" Padding="12,2"
                                                   Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:CardExpander>

            <!-- 日志 -->
            <ui:CardExpander ContentPadding="0" Icon="{ui:SymbolIcon DocumentJs16}">
                <ui:CardExpander.Header>
                    <Grid>
                        <ui:TextBlock FontTypography="Body" Text="日志" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <ListBox ItemsSource="{Binding LogLines}" Height="140" FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
