<Page x:Class="QxBgmManager.Pages.ConvertPage" Style="{StaticResource {x:Type Page}}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:QxBgmManager.Controls"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      Title="编码转换"
      d:DataContext="{d:DesignInstance Type=vm:ConvertViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" Text="编码转换" />

            <!-- 音频 → wem -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Icon="{ui:SymbolIcon ArrowSwap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="音频转 WEM" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="支持 MP3、WAV、FLAC 等音频，可直接拖入。" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,8,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="添加文件" Command="{Binding AddAudioFilesCommand}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:TextBlock VerticalAlignment="Center" FontTypography="Body" Text="输出目录" Margin="0,0,8,0" />
                            <ui:TextBox Width="320" Text="{Binding EncodeOutDir, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Content="浏览" Margin="6,0,0,0"
                                       Command="{Binding BrowseOutDirCommand}" CommandParameter="encode" />
                        </StackPanel>
                    </Grid>
                    <ListBox Margin="16" MinHeight="90" MaxHeight="220" AllowDrop="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding AudioJobs}"
                             Drop="AudioList_Drop"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding FileName}" Width="340" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <ComboBox Width="130" Margin="8,0,0,0" SelectedIndex="{Binding PresetIndex}"
                                              ItemsSource="{Binding DataContext.PresetNames, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    <CheckBox Content="全曲循环" Margin="10,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Loop}" />
                                    <TextBlock Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="16,0,16,16">
                        <ui:Button Content="开始转换" Appearance="Primary"
                                   Command="{Binding EnqueueEncodesCommand}"
                                   IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- wem → wav / mp3 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0"
                             Icon="{ui:SymbolIcon DocumentJs16}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="WEM 转音频" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="导出为 WAV 或 MP3。" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,8,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="添加 WEM" Command="{Binding AddWemFilesCommand}" />
                        <ComboBox Grid.Column="1" Width="80" Margin="10,0,0,0" SelectedIndex="{Binding DecodeFormatIndex}">
                            <ComboBoxItem Content="wav" />
                            <ComboBoxItem Content="mp3" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:TextBlock VerticalAlignment="Center" FontTypography="Body" Text="输出目录" Margin="0,0,8,0" />
                            <ui:TextBox Width="320" Text="{Binding DecodeOutDir, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Content="浏览" Margin="6,0,0,0"
                                       Command="{Binding BrowseOutDirCommand}" CommandParameter="decode" />
                        </StackPanel>
                    </Grid>
                    <ListBox Margin="16" MinHeight="80" MaxHeight="200" AllowDrop="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding WemJobs}"
                             Drop="WemList_Drop"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding FileName}" Width="420" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="16,0,16,16">
                        <ui:Button Content="开始转换" Appearance="Primary"
                                   Command="{Binding EnqueueDecodesCommand}"
                                   IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- pck 条目 → wem -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0"
                             Icon="{ui:SymbolIcon DataTreemap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="导出游戏音乐" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="选择曲目，导出 WEM 文件。" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" FontTypography="Body" Text="文件编号" Margin="0,0,8,0" />
                        <ui:TextBox Grid.Column="1" Text="{Binding ExtractFileIdText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" FontTypography="Body" Text="或从曲库选" Margin="12,0,8,0" />
                        <controls:TrackPicker x:Name="ExtractPicker" Grid.Column="3" ItemsSource="{Binding LibraryEntries}" SelectedTrack="{Binding SelectedLibraryEntry}" />
                        <ui:TextBlock Grid.Column="4" VerticalAlignment="Center" FontTypography="Body" Text="输出目录" Margin="12,0,8,0" />
                        <ui:TextBox Grid.Column="5" Text="{Binding ExtractOutDir, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="6" Content="浏览" Margin="6,0,0,0"
                                   Command="{Binding BrowseOutDirCommand}" CommandParameter="extract" />
                    </Grid>
                    <Grid Margin="16,0,16,16">
                        <ui:Button Content="导出" Appearance="Primary"
                                   Command="{Binding EnqueueExtractCommand}"
                                   IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 队列 -->
            <ui:CardExpander ContentPadding="0" IsExpanded="True" Icon="{ui:SymbolIcon Timer24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" FontTypography="Body"
                                      Text="{Binding QueueStatus, FallbackValue=队列空闲}" />
                        <ui:Button Grid.Column="1" Margin="0,0,8,0" Content="取消" Appearance="Secondary"
                                   Command="{Binding CancelQueueCommand}"
                                   IsEnabled="{Binding IsRunning}" />
                        <ui:Button Grid.Column="2" Margin="0,0,36,0" Content="清理已完成"
                                   Command="{Binding ClearFinishedCommand}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,8,16,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding QueueProgress}" Height="6" />
                    </Grid>
                    <ListBox Margin="16" MinHeight="80" MaxHeight="220" ItemsSource="{Binding Queue}" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Kind}" Width="90" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Detail}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Expander Header="详细日志" Margin="16,0,16,16">
                        <ListBox ItemsSource="{Binding LogLines}" Height="100" FontFamily="Consolas" FontSize="12"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                 BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    </Expander>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
