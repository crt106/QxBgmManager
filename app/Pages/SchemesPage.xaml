<Page x:Class="QxBgmManager.Pages.SchemesPage" Style="{StaticResource {x:Type Page}}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      Title="方案管理"
      d:DataContext="{d:DesignInstance Type=vm:SchemesViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" Text="方案管理" />

            <!-- 打开方案 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Icon="{ui:SymbolIcon FolderOpen24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="导入方案" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="选择方案文件或方案包。" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,36,0"
                                   Content="浏览" Command="{Binding BrowseSchemeCommand}" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding SchemePath, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="方案文件路径，选择后自动读取" />
                </Grid>
            </ui:CardExpander>

            <!-- 方案清单与执行 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Visibility="{Binding ManifestLoaded, Converter={StaticResource BoolToVis}}"
                             Icon="{ui:SymbolIcon DataTreemap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body"
                                      Text="{Binding ManifestName}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding ManifestMetaText}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,8,0"
                                   Content="安装" Appearance="Primary"
                                   Command="{Binding ExecuteCommand}"
                                   IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBool}}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,36,0"
                                   Content="取消" Appearance="Secondary"
                                   Command="{Binding CancelExecuteCommand}"
                                   IsEnabled="{Binding IsExecuting}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,8,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding ManifestDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ManifestDescription, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Row="1" Text="{Binding ManifestAuthor}" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Row="2" Text="{Binding WarningsText}" TextWrapping="Wrap"
                                   Foreground="#F2C94C"
                                   Visibility="{Binding WarningsText, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <DataGrid Margin="16" ItemsSource="{Binding Tracks}"
                              AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="Transparent" BorderThickness="0" MaxHeight="320"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="安装" Binding="{Binding Selected}" Width="50" />
                            <DataGridTextColumn Header="文件编号" Binding="{Binding FileId}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="曲名" Binding="{Binding RefName}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="kind" Binding="{Binding KindText}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="预设" Binding="{Binding PresetText}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="当前状态" Binding="{Binding EntryStatus}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="容量校验" Binding="{Binding CapacityResult}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="进度" Binding="{Binding Phase}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Margin="16,0,16,8">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExecuteProgress}" Height="6" />
                    </Grid>
                    <Grid Margin="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ExecuteStatus}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 奇域关联提示 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Globe24}"
                            Visibility="{Binding WonderPrompt, Converter={StaticResource BoolToVis}}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body"
                                      Text="{Binding WonderPrompt}" TextWrapping="Wrap" />
                        <ui:Button Grid.Row="0" Grid.Column="1" Margin="16,0,36,0"
                                   Content="登记到奇域档案" Appearance="Primary"
                                   Command="{Binding RegisterWonderCommand}" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- 已安装方案 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True"
                             Icon="{ui:SymbolIcon History24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="已安装方案" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="卸载后恢复原曲。" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <DataGrid ItemsSource="{Binding Installed}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                              Background="Transparent" BorderThickness="0" MaxHeight="260"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="140" />
                            <DataGridTextColumn Header="安装时间" Binding="{Binding TimeText}" Width="150" />
                            <DataGridTextColumn Header="曲目数" Binding="{Binding TrackCountText}" Width="80" />
                            <DataGridTemplateColumn Header="操作" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="卸载" Appearance="Danger" Padding="12,2"
                                                   Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:CardExpander>

            <!-- 导出方案 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0"
                             Icon="{ui:SymbolIcon ArrowSwap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="导出方案" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="将已替换的音乐打包分享。" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontTypography="Body" Text="方案 ID" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExportId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="字母数字连字符，如 th01-bgm-pack" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontTypography="Body" Text="名称" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ExportName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="显示名" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontTypography="Body" Text="作者" />
                        <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ExportAuthor, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontTypography="Body" Text="描述" />
                        <ui:TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ExportDescription, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="导出 .qxbgmzip" Appearance="Primary"
                                   Command="{Binding ExportCommand}" />
                        <TextBlock Grid.Column="1" Text="{Binding ExportStatus}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 日志 -->
            <ui:CardExpander ContentPadding="0" Icon="{ui:SymbolIcon DocumentJs16}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock FontTypography="Body" Text="日志" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <ListBox ItemsSource="{Binding LogLines}" Height="160" FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
