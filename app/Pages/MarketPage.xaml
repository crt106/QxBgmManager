<Page x:Class="QxBgmManager.Pages.MarketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      Title="方案市场"
      d:DataContext="{d:DesignInstance Type=vm:MarketViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" Text="方案市场" />

            <!-- 索引源 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="索引源" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding SourceText}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,8,0"
                                   Content="刷新/拉取" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Command="{Binding RefreshCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,36,0"
                                   Content="去设置" Appearance="Secondary"
                                   Command="{Binding OpenSettingsCommand}" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <TextBlock Margin="0,0,0,8" Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,0,0,8" Text="{Binding WarningsText}" TextWrapping="Wrap" Foreground="#F2C94C"
                       Visibility="{Binding WarningsText, Converter={StaticResource BoolToVis}}" />

            <!-- 奇域关联提示 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Globe24}"
                            Visibility="{Binding WonderPrompt, Converter={StaticResource BoolToVis}}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" FontTypography="Body"
                                      Text="{Binding WonderPrompt}" TextWrapping="Wrap" />
                        <ui:Button Grid.Column="1" Margin="16,0,36,0" Content="登记到奇域档案"
                                   Appearance="Primary" Command="{Binding RegisterWonderCommand}" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- 工具栏 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="搜索名称 / 作者 / 标签 / 描述"
                            Icon="{ui:SymbolIcon Search24}" />
                <ComboBox Grid.Column="1" Width="120" Margin="8,0,0,0"
                          ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
            </Grid>

            <!-- 条目列表 -->
            <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                        <ui:TextBlock Margin="8,0,0,0" FontTypography="Body"
                                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                      Text="{Binding VersionText}" />
                                        <ui:TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                      Foreground="#6EE7B7" Text="{Binding StateText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,0">
                                        <ui:TextBlock FontSize="12"
                                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                      Text="{Binding Author}" />
                                        <ui:TextBlock Margin="10,0,0,0" FontSize="12"
                                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                      Text="{Binding CategoryText}" />
                                        <ui:TextBlock Margin="10,0,0,0" FontSize="12"
                                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                      Text="{Binding TracksText}" />
                                        <ui:TextBlock Margin="10,0,0,0" FontSize="12"
                                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                      Text="{Binding UpdatedText}" />
                                        <ui:TextBlock Margin="10,0,0,0" FontSize="12"
                                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                      Text="{Binding WonderlandText}" />
                                    </StackPanel>
                                    <ui:TextBlock Grid.Row="2" Grid.Column="0" Margin="0,2,0,0" FontSize="12"
                                                  TextWrapping="Wrap"
                                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding Description}" />
                                    <ui:TextBlock Grid.Row="2" Grid.Column="0" Margin="0,18,0,0" FontSize="12"
                                                  Foreground="#F27A7A" Text="{Binding Detail}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                                Margin="16,0,36,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:Button Content="安装" Appearance="Primary" Padding="14,4"
                                                   Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding IsNotInstalled}" />
                                        <ui:Button Content="升级" Appearance="Primary" Padding="14,4" Margin="6,0,0,0"
                                                   Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding CanUpgrade}" />
                                        <ui:Button Content="卸载" Appearance="Danger" Padding="14,4" Margin="6,0,0,0"
                                                   Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding IsInstalled}" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardControl.Header>
                        </ui:CardControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 日志 -->
            <ui:CardExpander Margin="0,8,0,0" ContentPadding="0" Icon="{ui:SymbolIcon DocumentJs16}">
                <ui:CardExpander.Header>
                    <Grid>
                        <ui:TextBlock FontTypography="Body" Text="日志" />
                    </Grid>
                </ui:CardExpander.Header>
                <Grid Margin="16">
                    <ListBox ItemsSource="{Binding LogLines}" Height="120" FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
