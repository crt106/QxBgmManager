<Page x:Class="QxBgmManager.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      Title="设置"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12"
                       FontSize="18" FontWeight="SemiBold"
                       Text="设置" />

            <!-- 游戏根目录 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon FolderOpen24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0"
                                      FontTypography="Body"
                                      Text="游戏根目录" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding GameRootStatus}" />
                        <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                   Margin="0,0,36,0"
                                   Command="{Binding BrowseGameRootCommand}"
                                   Content="浏览" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding GameRoot, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="含 YuanShen_Data 的那一级，如 F:\Program Files\Genshin Impact\Genshin Impact Game" />
                    </Grid>
                    <Grid Margin="16,0,16,16">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock VerticalAlignment="Center"
                                          FontTypography="Body"
                                          Text="探测到的安装：" />
                            <ItemsControl ItemsSource="{Binding DetectedRoots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding}" Margin="6,0,0,0" Padding="10,3"
                                                   Appearance="Secondary"
                                                   Command="{Binding DataContext.UseDetectedRootCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Python -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon DeveloperBoard24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0"
                                      FontTypography="Body"
                                      Text="Python" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="3.13；编码脚本会从 vendor\python-deps 自加载 numpy。默认 python 由 PATH 解析。" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="python" />
                        <ui:Button Grid.Column="1" Margin="8,0,36,0"
                                   Command="{Binding BrowsePythonCommand}"
                                   Content="浏览" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- ffmpeg -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Wrench24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0"
                                      FontTypography="Body"
                                      Text="ffmpeg" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="8bit 预设的低通滤波用它；编码脚本内部解码 PCM 也走同一可执行文件。" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="D:\ffmpeg\ffmpeg-9.0.1-full_build\bin\ffmpeg.exe" />
                        <ui:Button Grid.Column="1" Margin="8,0,36,0"
                                   Command="{Binding BrowseFfmpegCommand}"
                                   Content="浏览" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 方案市场索引源 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="方案市场索引源" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="本地索引仓库路径（已克隆）或 git URL（自动浅克隆到 app\data\registry）" />
                    </Grid>
                </ui:CardControl.Header>
                <Grid MinWidth="420">
                    <ui:TextBox Text="{Binding RegistrySource, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="D:\ProgramSource2\qxbgm-registry 或 https://gitee.com/xxx/qxbgm-registry.git" />
                </Grid>
            </ui:CardControl>

            <!-- 外观 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Image24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0"
                                      FontTypography="Body"
                                      Text="外观" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="切换深浅主题（即时生效并保存）" />
                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Margin="0,0,36,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <!-- OneWay 只回显状态；用户点击经 SetTheme 命令显式改主题并保存。
                                 禁止 TwoWay + GroupName：组互斥逻辑在加载/绑定期会把瞬时取消勾选写回源，
                                 曾在无用户操作时将 ThemeDark 覆写为 false 并保存。 -->
                            <RadioButton Content="深色"
                                         IsChecked="{Binding ThemeDark, Mode=OneWay}"
                                         Command="{Binding SetThemeCommand}" CommandParameter="dark"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="浅色"
                                         IsChecked="{Binding ThemeDark, Converter={StaticResource InverseBool}, Mode=OneWay}"
                                         Command="{Binding SetThemeCommand}" CommandParameter="light" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ui:Button Content="保存设置" Command="{Binding SaveCommand}" Appearance="Primary"
                           Padding="20,6" Margin="0,0,8,0" />
                <ui:Button Content="打开环境检查" Command="{Binding OpenEnvCheckCommand}" Appearance="Secondary"
                           Padding="20,6" ToolTip="依赖检测已移至环境检查页" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
