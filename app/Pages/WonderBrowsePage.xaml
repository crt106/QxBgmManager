<Page x:Class="QxBgmManager.Pages.WonderBrowsePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:vm="clr-namespace:QxBgmManager.ViewModels"
      Title="奇域浏览"
      d:DataContext="{d:DesignInstance Type=vm:WonderBrowseViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" Text="奇域浏览" />

        <!-- 地址栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Width="34" Padding="0" ToolTip="后退"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       Command="{Binding GoBackCommand}"
                       IsEnabled="{Binding CanGoBack}" />
            <ui:Button Grid.Column="1" Width="34" Padding="0" Margin="4,0,0,0" ToolTip="前进"
                       Icon="{ui:SymbolIcon ArrowRight24}"
                       Command="{Binding GoForwardCommand}"
                       IsEnabled="{Binding CanGoForward}" />
            <ui:Button Grid.Column="2" Width="34" Padding="0" Margin="0,0,4,0" ToolTip="刷新"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Command="{Binding RefreshCommand}" />
            <ui:TextBox Grid.Column="3" x:Name="AddressBox"
                        Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="AddressBox_KeyDown"
                        PlaceholderText="输入 URL 或关键词（关键词走必应搜索）" />
            <ui:Button Grid.Column="4" Content="前往" Margin="6,0,0,0"
                       Command="{Binding GoCommand}" />
        </Grid>

        <!-- 书签栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Bookmarks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <ui:Button Padding="10,3" Appearance="Secondary"
                                       Command="{Binding DataContext.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       ToolTip="{Binding Url}"
                                       Content="{Binding Title}" />
                            <ui:Button Width="22" Padding="0" Margin="2,0,0,0"
                                       Appearance="Secondary" ToolTip="移除书签"
                                       Command="{Binding DataContext.RemoveBookmarkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       Content="✕" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button Grid.Column="1" Content="收藏当前页" Margin="6,0,0,0"
                       Command="{Binding AddBookmarkCommand}" />
            <ui:Button Grid.Column="2" Content="主页" Margin="6,0,0,0"
                       Command="{Binding GoHomeCommand}" />
        </Grid>

        <!-- 浏览器 -->
        <Grid Grid.Row="3">
            <wv2:WebView2 x:Name="Browser"
                          Visibility="{Binding HasBrowserError, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            <ui:InfoBar VerticalAlignment="Top"
                        Title="内嵌浏览器不可用"
                        Message="{Binding BrowserError}"
                        Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasBrowserError}" />
        </Grid>

        <!-- 奇域档案 -->
        <ui:CardExpander Grid.Row="4" Margin="0,8,0,0" ContentPadding="0"
                         Icon="{ui:SymbolIcon Globe24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="奇域档案" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding ArchiveStatus, FallbackValue=本地登记表：奇域ID / 名称 / 链接 / 备注 / 关联方案ID，供后续按奇域关联 BGM 方案}" />
                    <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,6,0"
                               Content="从当前网页登记" Command="{Binding RegisterFromWebCommand}" />
                    <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,6,0"
                               Content="添加" Command="{Binding AddWonderCommand}" />
                    <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Margin="0,0,6,0"
                               Content="删除选中" Appearance="Secondary"
                               Command="{Binding RemoveWonderCommand}"
                               CommandParameter="{Binding SelectedWonder}" />
                    <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Margin="0,0,36,0"
                               Content="保存" Appearance="Primary"
                               Command="{Binding SaveWondersCommand}" />
                </Grid>
            </ui:CardExpander.Header>
            <Grid Margin="16">
                <DataGrid ItemsSource="{Binding Wonders}" SelectedItem="{Binding SelectedWonder}"
                          AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0"
                          Background="Transparent" BorderThickness="0" MaxHeight="220"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="奇域ID" Binding="{Binding Id}" Width="110" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="链接" Binding="{Binding Url}" Width="260" />
                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="160" />
                        <DataGridTextColumn Header="关联方案ID" Binding="{Binding SchemeId}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ui:CardExpander>
    </Grid>
</Page>
