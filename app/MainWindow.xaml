<ui:FluentWindow x:Class="QxBgmManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:QxBgmManager.Pages"
        xmlns:services="clr-namespace:QxBgmManager.Services"
        Title="千星BGM替换管理器"
        Width="1280" Height="800" MinWidth="1100" MinHeight="520"
        d:DesignHeight="800" d:DesignWidth="1280"
        ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
        ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{StaticResource TextThemeFontFamily}"
        WindowBackdropType="Auto"
        WindowStartupLocation="CenterScreen"
        WindowCornerPreference="Round"
        mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <!-- 组标题小号、弱化色；左边距 = WPF-UI 4.2 左侧导航项模板的图标列宽 40px
             （NavigationViewLeftMinimalCompact.xaml 中 ColumnDefinition Width="40"），
             使标题文字与菜单项文字同一左边界，而非与图标对齐。 -->
        <!-- 组标题小号、弱化色；左边距 = WPF-UI 4.2 左侧导航项模板的图标列宽 40px
             （NavigationViewLeftMinimalCompact.xaml 中 ColumnDefinition Width="40"），
             使标题文字与菜单项文字同一左边界，而非与图标对齐。
             默认模板内容居中（对齐 setter 无效），故自定义模板为左对齐 TextBlock。 -->
        <Style BasedOn="{StaticResource {x:Type ui:NavigationViewItemHeader}}"
               TargetType="{x:Type ui:NavigationViewItemHeader}">
            <Setter Property="Margin" Value="40,12,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:NavigationViewItemHeader}">
                        <TextBlock HorizontalAlignment="Left"
                                   Text="{TemplateBinding Text}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="MusicNote224" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="False"
                           OpenPaneLength="200"
                           Transition="None"
                           PaneTitle="千星BGM替换管理器"
                           SelectionChanged="RootNavigation_SelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItemHeader Text="工具" />
                <!-- NavigationCacheMode=Required：导航离开不销毁页面实例，任务状态不丢 -->
                <ui:NavigationViewItem Content="曲库" TargetPageType="{x:Type pages:LibraryPage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="MusicNote224" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="替换中心" TargetPageType="{x:Type pages:ReplaceCenterPage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="编码转换" TargetPageType="{x:Type pages:ConvertPage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="奇域浏览" TargetPageType="{x:Type pages:WonderBrowsePage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Globe24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemHeader Text="管理" />
                <ui:NavigationViewItem Content="方案市场" TargetPageType="{x:Type pages:MarketPage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="方案管理" TargetPageType="{x:Type pages:SchemesPage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataTreemap24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="环境检查" TargetPageType="{x:Type pages:EnvCheckPage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DeveloperBoard24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="设置" TargetPageType="{x:Type pages:SettingsPage}" NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <!-- 新版本提示（BetterGI 兑换码通知卡同款版式）：点击跳转设置页更新卡片 -->
                <Border x:Name="UpdateBanner"
                        MinWidth="220"
                        Margin="0,8,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Cursor="Hand"
                        MouseLeftButtonDown="UpdateBanner_Click"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Opacity="0.2" ShadowDepth="2" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                CornerRadius="4,0,0,4" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                Padding="14,10">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="🎁 发现新版本 v" /><Run x:Name="UpdateBannerVersion" Text="" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="点击查看更新详情" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <Border x:Name="TaskFooter" Grid.Row="2" Padding="18,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                DataContext="{x:Static services:TaskActivityService.Current}"
                Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Margin="0,0,0,6" />
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="4" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="取消任务" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
